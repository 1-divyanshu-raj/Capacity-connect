# ---------------------------------------------------------------------------
# CAPACITY CONNECT - environment template
# Copy to `.env` (git-ignored). `.env` is never committed and never bundled:
# the Vite `envPrefix` in vite.config.ts is set to an unmatchable value, so no
# environment variable can reach a client asset.
# ---------------------------------------------------------------------------

# --- Secrets ---------------------------------------------------------------
# Signing key for session cookies, 2FA challenge tokens and certificate
# digests. REQUIRED in production; 32+ characters or the server refuses boot.
#   generate:  openssl rand -hex 32
SESSION_SECRET=

# Gemini API key (server-side only; the portal degrades to its local
# Earth-Sciences knowledge base when unset).
GEMINI_API_KEY=
# Optional: override the upstream model id (allowlisted characters only).
GEMINI_MODEL=

# --- Credentials -----------------------------------------------------------
# Real personnel secrets. When unset and DEMO_MODE=true the built-in demo
# secrets are used so evaluations keep working; set these + DEMO_MODE=false
# for any deployment that is reachable from the internet.
TRAINEE_PASSWORD=
TRAINER_PASSWORD=
ADMIN_PASSWORD=

# Demo affordances (auto-fill buttons, OTP echo, SSO hand-off). Set to false
# for production; that single flag removes every "demo convenience" that a
# penetration test would otherwise report as a hardcoded-credential finding.
DEMO_MODE=true

# --- Sessions & cookies ----------------------------------------------------
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=12
# Set 0 when running WITHOUT a TLS-terminating proxy; keep 1+ behind one so
# per-client rate limiting and audit logs see the real source address.
TRUST_PROXY=1

# --- Rate limiting / lockout ----------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_MCQ_MAX=10
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CERT_MAX=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MS=900000

# --- Second factor ---------------------------------------------------------
DEMO_OTP=982401
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=10

# --- Network / headers -----------------------------------------------------
PORT=3000
HOST=0.0.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,.e2b.app,.vercel.app
# Origins allowed to frame the portal (defaults to 'self' only).
ALLOWED_FRAME_ANCESTORS=
ENABLE_CSP=true
CSP_REPORT_ONLY=false
ENABLE_NOINDEX=true
HSTS_MAX_AGE=31536000
# Extra CSP connect-src entries (leave empty unless you add a new API host).
CSP_CONNECT_EXTRA=
CSP_FRAME_SRC=https://www.youtube.com,https://www.youtube-nocookie.com,https://storage.googleapis.com
# Cross-origin API consumers. Empty = strictly same-origin (no CORS granted).
CORS_ALLOWED_ORIGINS=
BODY_LIMIT=32kb

# --- Diagnostics -----------------------------------------------------------
LOG_LEVEL=info
AUDIT_RING_SIZE=500
MAX_TRACKED_KEYS=20000
# Never enable outside a local debugging session.
SHOW_ERROR_DETAILS=false
